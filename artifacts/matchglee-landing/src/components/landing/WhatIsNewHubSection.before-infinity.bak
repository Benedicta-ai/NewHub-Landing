import { motion, useReducedMotion } from "framer-motion";
import {
  BriefcaseBusiness,
  Sparkles,
  UserRound,
  UsersRound,
  type LucideIcon,
} from "lucide-react";
import { BRAND_GRADIENT_TEXT } from "@/lib/brand";

import personalImage from "@/assets/newhub_carousel_assets/09_personal.png";
import professionalImage from "@/assets/newhub_carousel_assets/10_professional.png";
import communitiesImage from "@/assets/newhub_carousel_assets/11_communities_alt.png";

interface NewHubCard {
  icon: LucideIcon;
  number: string;
  title: string;
  description: string;
  image: string;
  imageAlt: string;
  label: string;
  initialX: number;
  initialY: number;
  initialRotate: number;
  delay: number;
  floatDistance: number;
  floatDuration: number;
  cardClassName: string;
  iconClassName: string;
  glowClassName: string;
}

const cards: NewHubCard[] = [
  {
    icon: UserRound,
    number: "01",
    title: "Personal",
    description:
      "Express your personality, interests, passions and the moments that matter beyond your career.",
    image: personalImage,
    imageAlt: "Personal identity and lifestyle representation",
    label: "Be completely yourself",
    initialX: -90,
    initialY: 75,
    initialRotate: -7,
    delay: 0.05,
    floatDistance: 8,
    floatDuration: 5.4,
    cardClassName: "lg:mt-12",
    iconClassName:
      "bg-[#F0199A]/10 text-[#D71C91] dark:bg-[#F0199A]/15 dark:text-pink-300",
    glowClassName: "bg-[#F0199A]/15 dark:bg-[#F0199A]/10",
  },
  {
    icon: BriefcaseBusiness,
    number: "02",
    title: "Professional",
    description:
      "Present your skills, ambitions and experience while discovering opportunities that fit your direction.",
    image: professionalImage,
    imageAlt: "Professional identity and career growth representation",
    label: "Build with purpose",
    initialX: 0,
    initialY: 110,
    initialRotate: 0,
    delay: 0.16,
    floatDistance: 11,
    floatDuration: 6.2,
    cardClassName: "lg:-mt-5",
    iconClassName:
      "bg-[#7132C8]/10 text-[#7132C8] dark:bg-[#7132C8]/20 dark:text-purple-300",
    glowClassName: "bg-[#7132C8]/16 dark:bg-[#7132C8]/12",
  },
  {
    icon: UsersRound,
    number: "03",
    title: "Communities",
    description:
      "Find people who share your interests, exchange ideas and belong to spaces that feel meaningful.",
    image: communitiesImage,
    imageAlt: "Online communities and shared interests representation",
    label: "Find your people",
    initialX: 90,
    initialY: 75,
    initialRotate: 7,
    delay: 0.27,
    floatDistance: 7,
    floatDuration: 5.8,
    cardClassName: "lg:mt-12",
    iconClassName:
      "bg-blue-500/10 text-blue-600 dark:bg-blue-500/15 dark:text-blue-300",
    glowClassName: "bg-blue-400/14 dark:bg-blue-500/10",
  },
];

interface FloatingCardProps {
  card: NewHubCard;
}

function FloatingCard({ card }: FloatingCardProps) {
  const reduceMotion = useReducedMotion();
  const Icon = card.icon;

  return (
    <motion.article
      initial={
        reduceMotion
          ? {
              opacity: 0,
            }
          : {
              opacity: 0,
              x: card.initialX,
              y: card.initialY,
              rotate: card.initialRotate,
              scale: 0.86,
              filter: "blur(10px)",
            }
      }
      whileInView={{
        opacity: 1,
        x: 0,
        y: 0,
        rotate: 0,
        scale: 1,
        filter: "blur(0px)",
      }}
      viewport={{
        once: true,
        amount: 0.25,
        margin: "0px 0px -70px 0px",
      }}
      transition={{
        duration: 0.9,
        delay: card.delay,
        ease: [0.22, 1, 0.36, 1],
      }}
      className={`
        relative
        ${card.cardClassName}
      `}
    >
      <motion.div
        animate={
          reduceMotion
            ? undefined
            : {
                y: [0, -card.floatDistance, 0],
              }
        }
        transition={{
          duration: card.floatDuration,
          repeat: Infinity,
          repeatType: "mirror",
          ease: "easeInOut",
          delay: card.delay + 0.8,
        }}
        whileHover={
          reduceMotion
            ? undefined
            : {
                y: -12,
                scale: 1.015,
              }
        }
        className="
          group
          relative
          h-full
          overflow-hidden
          rounded-[30px]
          border
          border-[#7132C8]/15
          bg-white/75
          p-3
          shadow-[0_24px_80px_rgba(77,48,140,0.12)]
          backdrop-blur-2xl
          transition-[background-color,border-color,box-shadow]
          duration-500
          hover:border-[#7132C8]/30
          hover:bg-white/95
          hover:shadow-[0_34px_100px_rgba(77,48,140,0.18)]
          dark:border-white/10
          dark:bg-white/[0.045]
          dark:shadow-[0_28px_90px_rgba(0,0,0,0.34)]
          dark:hover:border-white/20
          dark:hover:bg-white/[0.07]
        "
      >
        {/* Ambient card glow */}
        <div
          aria-hidden="true"
          className={`
            pointer-events-none
            absolute
            -right-16
            -top-16
            h-44
            w-44
            rounded-full
            blur-[65px]
            ${card.glowClassName}
          `}
        />

        {/* Floating image panel */}
        <div
          className="
            relative
            h-[255px]
            overflow-hidden
            rounded-[23px]
            sm:h-[285px]
            lg:h-[315px]
          "
        >
          <motion.img
            src={card.image}
            alt={card.imageAlt}
            loading="lazy"
            decoding="async"
            whileHover={
              reduceMotion
                ? undefined
                : {
                    scale: 1.055,
                  }
            }
            transition={{
              duration: 0.75,
              ease: [0.22, 1, 0.36, 1],
            }}
            className="
              h-full
              w-full
              object-cover
            "
          />

          <div
            aria-hidden="true"
            className="
              pointer-events-none
              absolute
              inset-0
              bg-gradient-to-t
              from-[#110a1e]/80
              via-transparent
              to-white/5
            "
          />

          <div
            aria-hidden="true"
            className="
              pointer-events-none
              absolute
              inset-0
              bg-gradient-to-br
              from-[#F0199A]/10
              via-transparent
              to-[#7132C8]/15
            "
          />

          <div
            className="
              absolute
              left-4
              top-4
              flex
              h-10
              w-10
              items-center
              justify-center
              rounded-2xl
              border
              border-white/20
              bg-black/25
              text-white
              backdrop-blur-xl
            "
          >
            <Icon className="h-[18px] w-[18px]" />
          </div>

          <div
            className="
              absolute
              right-4
              top-4
              rounded-full
              border
              border-white/20
              bg-black/25
              px-3
              py-1.5
              text-[10px]
              font-bold
              tracking-[0.15em]
              text-white/80
              backdrop-blur-xl
            "
          >
            {card.number}
          </div>

          <div
            className="
              absolute
              bottom-4
              left-4
              rounded-full
              border
              border-white/20
              bg-black/25
              px-3
              py-1.5
              text-[10px]
              font-semibold
              uppercase
              tracking-[0.15em]
              text-white/80
              backdrop-blur-xl
            "
          >
            {card.label}
          </div>
        </div>

        {/* Text content */}
        <div className="relative p-5 pb-6 sm:p-6">
          <div
            className={`
              mb-5
              flex
              h-11
              w-11
              items-center
              justify-center
              rounded-2xl
              ${card.iconClassName}
            `}
          >
            <Icon className="h-5 w-5" />
          </div>

          <h3
            className="
              text-2xl
              font-black
              tracking-[-0.04em]
              text-[#17152a]
              dark:text-white
              sm:text-[28px]
            "
          >
            {card.title}
          </h3>

          <p
            className="
              mt-3
              text-sm
              leading-7
              text-[#6d6a80]
              dark:text-white/50
            "
          >
            {card.description}
          </p>

          <div
            className="
              mt-6
              h-px
              w-full
              bg-gradient-to-r
              from-[#7132C8]/20
              via-[#F0199A]/12
              to-transparent
              dark:from-white/15
              dark:via-white/5
            "
          />
        </div>
      </motion.div>
    </motion.article>
  );
}


            right-4
            top-4
            rounded-full
            border
            border-white/20
            bg-black/25
            px-3
            py-1.5
            text-[10px]
            font-bold
            tracking-[0.16em]
            text-white/80
            backdrop-blur-xl
          "
        >
          {reason.number}
        </span>

        <span
          className="
            absolute
            bottom-4
            left-4
            right-4
            w-fit
            rounded-full
            border
            border-white/20
            bg-black/25
            px-3
            py-1.5
            text-[10px]
            font-semibold
            uppercase
            tracking-[0.13em]
            text-white/80
            backdrop-blur-xl
          "
        >
          {reason.tag}

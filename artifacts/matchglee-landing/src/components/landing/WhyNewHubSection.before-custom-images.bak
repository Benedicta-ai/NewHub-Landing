        once: true,
        amount: 0.2,
      }}
      transition={{
        duration: 0.75,
        delay: reason.delay,
        ease: [0.22, 1, 0.36, 1],
      }}
      whileHover={
        reduceMotion
          ? undefined
          : {
              y: -9,
            }
      }
      className="
        group
        relative
        flex
        h-full
        flex-col
        overflow-hidden
        rounded-[30px]
        border

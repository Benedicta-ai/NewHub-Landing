    imageAlt: "Digital privacy shield protecting personal information",
    tag: "Your identity. Your control.",
    accentClassName: "from-[#F0199A]/20 via-[#F0199A]/5 to-transparent",
    iconClassName:
      "bg-[#F0199A]/10 text-[#D61A8D] dark:bg-[#F0199A]/15 dark:text-pink-300",
    delay: 0.05,
  },
  {
    icon: HeartHandshake,
    number: "02",
    title: "Meaningful Connections",
    description:
      "Build relationships based on shared values, genuine interests and conversations that go beyond surface-level networking.",

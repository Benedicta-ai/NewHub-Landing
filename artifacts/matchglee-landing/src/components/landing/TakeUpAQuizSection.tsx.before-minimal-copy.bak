  },
  {
    number: "02",
    title: "Quiz",
    description: "Answer a few simple questions about what matters to you.",
    icon: Sparkles,
  },
  {
    number: "03",
    title: "Chapter 1",
    description:
      "Explore insights about your personal and professional identity.",
    icon: BookOpen,
  },
  {
    number: "04",
    title: "Chapter 2",
    description: "Discover how meaningful connections can support your growth.",
    icon: BookOpen,
  },
  {
    number: "05",
    title: "Get Early Access",
    description:
      "Complete the journey and become one of the first to experience NewHub.",
    icon: CheckCircle2,
  },
];

interface TakeUpAQuizSectionProps {

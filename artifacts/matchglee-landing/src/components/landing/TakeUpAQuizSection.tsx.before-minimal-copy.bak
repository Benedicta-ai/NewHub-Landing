                        -right-1
                        -top-1
                        flex
                        h-6
                        min-w-6
                        items-center
                        justify-center
                        rounded-full
                        border
                        border-white/30
                        bg-[#171022]
                        px-1
                        text-[8px]
                        font-black
                        tracking-[0.08em]

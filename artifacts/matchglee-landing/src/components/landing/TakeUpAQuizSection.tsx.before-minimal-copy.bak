              inline-flex
              min-h-14
              items-center
              justify-center
              gap-3
              rounded-full
              px-8
              py-4
              text-sm
              font-bold
              text-white
              shadow-[0_16px_40px_rgba(240,25,154,0.24)]
              transition-all
              duration-300
              hover:-translate-y-1
              hover:scale-[1.02]
              hover:shadow-[0_20px_50px_rgba(240,25,154,0.36)]
